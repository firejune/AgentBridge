    {
      "name": "bridge_message_send",
      "description": "Asynchronously accept an exact message for a caller-owned dedicated adapter session. Preserve message code points and UTF-8 bytes exactly: no trimming or normalization. maxLength is a character precheck; runtime MUST reject UTF-8 encoded length above 32768 bytes before durable acceptance. At most one message operation may be in flight per session; reject SESSION_BUSY before durable acceptance. Durable key and dispatch intent must precede side effects; uncertainty becomes unknown, never automatic replay. Downstream agent may change files or contact external services. No cwd/model/shell arguments. Absent in Phase 0; explicit post-verification write enablement is required.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "agent_session_id": {
            "type": "string",
            "pattern": "^as_[A-Za-z0-9_-]{16,128}$",
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            }
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "description": "Exact message; at most 32768 UTF-8 bytes at runtime. Unicode character limit alone is not the byte limit."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "description": "Required durable idempotency key. Bind to authenticated caller, tool, and canonical request encoding that preserves exact message bytes. Same key with changed arguments conflicts; a replay does not dispatch again.",
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            }
          }
        },
        "required": [
          "agent_session_id",
          "message",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "message_request_id": {
                "type": "string",
                "pattern": "^msg_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "kind": {
                "type": "string",
                "const": "message_send"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              },
              "replayed": {
                "type": "boolean"
              }
            },
            "required": [
              "operation_id",
              "message_request_id",
              "kind",
              "accepted_at",
              "replayed"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "PHASE_DISABLED",
                  "NOT_AUTHORIZED",
                  "NOT_FOUND",
                  "WORKSPACE_NOT_ALLOWED",
                  "IDEMPOTENCY_CONFLICT",
                  "IDEMPOTENCY_EXPIRED",
                  "SESSION_BUSY",
                  "CAPACITY_EXCEEDED",
                  "BACKEND_UNAVAILABLE",
                  "BACKEND_PROTOCOL_ERROR",
                  "DELIVERY_UNKNOWN",
                  "OPERATION_EXPIRED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "retryable": {
                "type": "boolean"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "not": {
              "required": [
