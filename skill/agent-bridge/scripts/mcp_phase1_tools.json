{
  "tools": [
    {
      "name": "bridge_status",
      "description": "Read adapter connectivity, runtime exposure, configured alias names, and limits. Phase 0 exposes ONLY this tool. Does not prove Dot custom-MCP compatibility. Caller identity and authorization come exclusively from the connection. Annotations are advisory, never authorization.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1.0"
              },
              "server_time": {
                "type": "string",
                "format": "date-time"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "connectivity_only",
                  "enabled"
                ]
              },
              "daemon_status": {
                "type": "string",
                "enum": [
                  "ready",
                  "degraded",
                  "unreachable"
                ]
              },
              "writes_enabled": {
                "type": "boolean"
              },
              "enabled_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "bridge_status",
                    "bridge_sessions_list",
                    "bridge_session_create",
                    "bridge_message_send",
                    "bridge_operation_get"
                  ]
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "contains": {
                  "const": "bridge_status"
                }
              },
              "allowed_workspace_aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                  "description": "An operator-configured alias returned by bridge_status; never a path or arbitrary cwd.",
                  "not": {
                    "pattern": "[^A-Za-z0-9_-]"
                  }
                },
                "uniqueItems": true
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "dedicated_claude_sessions": {
                    "type": "boolean"
                  },
                  "asynchronous_operations": {
                    "type": "boolean"
                  },
                  "durable_idempotency": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "dedicated_claude_sessions",
                  "asynchronous_operations",
                  "durable_idempotency"
                ],
                "additionalProperties": false
              },
              "limits": {
                "type": "object",
                "properties": {
                  "max_message_bytes": {
                    "type": "integer",
                    "const": 32768
                  },
                  "max_wait_ms": {
                    "type": "integer",
                    "const": 5000
                  },
                  "max_result_page_chars": {
                    "type": "integer",
                    "const": 16000
                  },
                  "operation_retention_hours": {
                    "type": "integer",
                    "const": 168
                  },
                  "idempotency_retention_hours": {
                    "type": "integer",
                    "const": 720
                  }
                },
                "required": [
                  "max_message_bytes",
                  "max_wait_ms",
                  "max_result_page_chars",
                  "operation_retention_hours",
                  "idempotency_retention_hours"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "contract_version",
              "server_time",
              "phase",
              "daemon_status",
              "writes_enabled",
              "enabled_tools",
              "allowed_workspace_aliases",
              "capabilities",
              "limits"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "phase": {
                      "const": "connectivity_only"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "writes_enabled": {
                      "const": false
                    },
                    "enabled_tools": {
                      "const": [
                        "bridge_status"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "writes_enabled": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "enabled_tools": {
                      "not": {
                        "contains": {
                          "enum": [
                            "bridge_session_create",
                            "bridge_message_send"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "writes_enabled": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "phase": {
                      "const": "enabled"
                    },
                    "enabled_tools": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "bridge_session_create"
                          }
                        },
                        {
                          "contains": {
                            "const": "bridge_message_send"
                          }
                        }
                      ]
                    },
                    "capabilities": {
                      "properties": {
                        "durable_idempotency": {
                          "const": true
                        },
                        "dedicated_claude_sessions": {
                          "const": true
                        },
                        "asynchronous_operations": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "PHASE_DISABLED",
                  "NOT_AUTHORIZED",
                  "NOT_FOUND",
                  "WORKSPACE_NOT_ALLOWED",
                  "IDEMPOTENCY_CONFLICT",
                  "IDEMPOTENCY_EXPIRED",
                  "SESSION_BUSY",
                  "CAPACITY_EXCEEDED",
                  "BACKEND_UNAVAILABLE",
                  "BACKEND_PROTOCOL_ERROR",
                  "DELIVERY_UNKNOWN",
                  "OPERATION_EXPIRED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "retryable": {
                "type": "boolean"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "not": {
              "required": [
                "data"
              ]
            }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "bridge_sessions_list",
      "description": "List only the authenticated caller's dedicated adapter-owned Claude sessions. Existing HQ sessions are excluded by default; no transcript, title, or path is exposed. Not registered in Phase 0. Cursor is caller-bound; adapter-normalized state is not raw backend message state.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Opaque, caller-bound pagination cursor. Never parse or construct it."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent_session_id": {
                      "type": "string",
                      "pattern": "^as_[A-Za-z0-9_-]{16,128}$",
                      "not": {
                        "pattern": "[^A-Za-z0-9_-]"
                      }
                    },
                    "agent_type": {
                      "type": "string",
                      "const": "claude"
                    },
                    "workspace_alias": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                      "description": "An operator-configured alias returned by bridge_status; never a path or arbitrary cwd.",
                      "not": {
                        "pattern": "[^A-Za-z0-9_-]"
                      }
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "busy",
                        "unavailable"
                      ],
                      "description": "Adapter-normalized session state; not the backend message state."
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "last_activity_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "agent_session_id",
                    "agent_type",
                    "workspace_alias",
                    "state",
                    "created_at",
                    "last_activity_at"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Opaque, caller-bound pagination cursor. Never parse or construct it."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "has_more": {
                "type": "boolean"
              }
            },
            "required": [
              "sessions",
              "next_cursor",
              "has_more"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "has_more": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "next_cursor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "description": "Opaque, caller-bound pagination cursor. Never parse or construct it."
                    }
                  }
                },
                "else": {
                  "properties": {
                    "next_cursor": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "PHASE_DISABLED",
                  "NOT_AUTHORIZED",
                  "NOT_FOUND",
                  "WORKSPACE_NOT_ALLOWED",
                  "IDEMPOTENCY_CONFLICT",
                  "IDEMPOTENCY_EXPIRED",
                  "SESSION_BUSY",
                  "CAPACITY_EXCEEDED",
                  "BACKEND_UNAVAILABLE",
                  "BACKEND_PROTOCOL_ERROR",
                  "DELIVERY_UNKNOWN",
                  "OPERATION_EXPIRED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "retryable": {
                "type": "boolean"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "not": {
              "required": [
                "data"
              ]
            }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "bridge_session_create",
      "description": "Asynchronously accept creation of a dedicated Claude session in an operator-allowed workspace alias. Return only durable acceptance; poll bridge_operation_get for the session ID. Requires durable adapter idempotency and dispatch-intent ledger verified before registration; backend memory-only deduplication is insufficient. No caller, cwd, model, shell, or arguments are accepted. Absent in Phase 0; operator must explicitly enable writes after read-only integration verification.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace_alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "description": "An operator-configured alias returned by bridge_status; never a path or arbitrary cwd.",
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            }
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{16,128}$",
            "description": "Required durable idempotency key. Bind to authenticated caller, tool, and canonical request encoding that preserves exact message bytes. Same key with changed arguments conflicts; a replay does not dispatch again.",
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            }
          }
        },
        "required": [
          "workspace_alias",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "kind": {
                "type": "string",
                "const": "session_create"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              },
              "replayed": {
                "type": "boolean"
              }
            },
            "required": [
              "operation_id",
              "kind",
              "accepted_at",
              "replayed"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "PHASE_DISABLED",
                  "NOT_AUTHORIZED",
                  "NOT_FOUND",
                  "WORKSPACE_NOT_ALLOWED",
                  "IDEMPOTENCY_CONFLICT",
                  "IDEMPOTENCY_EXPIRED",
                  "SESSION_BUSY",
                  "CAPACITY_EXCEEDED",
                  "BACKEND_UNAVAILABLE",
                  "BACKEND_PROTOCOL_ERROR",
                  "DELIVERY_UNKNOWN",
                  "OPERATION_EXPIRED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "retryable": {
                "type": "boolean"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
