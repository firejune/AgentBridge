    {
      "name": "bridge_operation_get",
      "description": "Read only an operation owned by the authenticated caller for a dedicated adapter session. Optional bounded long-poll; no dispatch or replay. Result exists only on succeeded, failure only on failed/unknown. An unknown operation outcome is a successful read with status=unknown, not a tool-call error. Cursor is valid only for completed message-result pagination over immutable Unicode-code-point windows; max_chars also bounds the returned page. Never return another caller's or session's result. Session-create success IDs must agree across data and result. Backend message state is separately observed and is not the adapter status. Absent in Phase 0.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            }
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "default": 0
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Opaque, caller-bound pagination cursor. Never parse or construct it."
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16000,
            "default": 8000
          }
        },
        "required": [
          "operation_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "session_create",
                  "message_send"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "accepted",
                  "running",
                  "succeeded",
                  "failed",
                  "unknown"
                ]
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time"
              },
