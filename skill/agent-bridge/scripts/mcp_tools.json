{
  "tools": [
    {
      "name": "bridge_status",
      "description": "Read adapter connectivity, runtime/schema revisions, supported agent provider types, runtime exposure, configured alias names, and limits. Phase 0 exposes ONLY this tool. Server revisions and supported_agent_types reflect server-side contract support only, neither live provider process availability nor client-side cached tool catalog state. Caller identity and authorization come exclusively from the connection. Annotations are advisory, never authorization.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "0.1.0"
              },
              "runtime_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Server runtime revision or digest currently executing on the host. Reflects server code only, not client-cached tool schemas."
              },
              "tool_schema_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Deterministic digest of the server's currently exposed tools/list schema catalog. Does not prove the client has refreshed its cached catalog."
              },
              "supported_agent_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "agy",
                    "codex"
                  ]
                },
                "uniqueItems": true,
                "description": "Agent providers supported by the server contract in this phase; indicates adapter capability, not live runtime availability of individual provider processes."
              },
              "server_time": {
                "type": "string",
                "format": "date-time"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "connectivity_only",
                  "enabled"
                ]
              },
              "daemon_status": {
                "type": "string",
                "enum": [
                  "ready",
                  "degraded",
                  "unreachable"
                ]
              },
              "writes_enabled": {
                "type": "boolean"
              },
              "enabled_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "bridge_status",
                    "bridge_sessions_list",
                    "bridge_session_create",
                    "bridge_message_send",
                    "bridge_operation_get",
                    "bridge_inbox_list",
                    "bridge_message_get",
                    "bridge_message_ack",
                    "bridge_message_reply"
                  ]
                },
                "minItems": 1,
                "maxItems": 9,
                "uniqueItems": true,
                "contains": {
                  "const": "bridge_status"
                }
              },
              "allowed_workspace_aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                  "description": "An operator-configured alias returned by bridge_status; never a path or arbitrary cwd.",
                  "not": {
                    "pattern": "[^A-Za-z0-9_-]"
                  }
                },
                "uniqueItems": true
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "dedicated_claude_sessions": {
                    "type": "boolean"
                  },
                  "asynchronous_operations": {
                    "type": "boolean"
                  },
                  "durable_idempotency": {
                    "type": "boolean"
                  },
                  "events": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "dedicated_claude_sessions",
                  "asynchronous_operations",
                  "durable_idempotency"
                ],
                "additionalProperties": false
              },
              "limits": {
                "type": "object",
                "properties": {
                  "max_message_bytes": {
                    "type": "integer",
                    "const": 32768
                  },
                  "max_wait_ms": {
                    "type": "integer",
                    "const": 5000
                  },
                  "max_result_page_chars": {
                    "type": "integer",
                    "const": 16000
                  },
                  "operation_retention_hours": {
                    "type": "integer",
                    "const": 168
                  },
                  "idempotency_retention_hours": {
                    "type": "integer",
                    "const": 720
                  }
                },
                "required": [
                  "max_message_bytes",
                  "max_wait_ms",
                  "max_result_page_chars",
                  "operation_retention_hours",
                  "idempotency_retention_hours"
                ],
                "additionalProperties": false
              },
              "events": {
                "type": "object",
                "properties": {
                  "active_subscriptions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "watching_routes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "queued_notifications": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "watch_gaps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "callback_failures": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "last_error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "replay_supported": {
                    "type": "boolean",
                    "const": false
                  },
                  "pending_key_deletions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uninitialized_agent_session_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "request_diagnostics": {
                    "type": "object",
                    "properties": {
                      "started_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "methods": {
                        "type": "object",
                        "propertyNames": {
                          "enum": [
                            "events/list",
                            "events/subscribe",
                            "events/unsubscribe"
                          ]
                        },
                        "required": [
                          "events/list",
                          "events/subscribe",
                          "events/unsubscribe"
                        ],
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "received_count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "accepted_count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "failed_count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "last_received_at": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date-time"
                            },
                            "last_stage": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "enum": [
                                "received",
                                "authorize",
                                "validate",
                                "resolve_routes",
                                "verify_callback",
                                "start_watchers",
                                "reserve_key_reference",
                                "store_signing_key",
                                "persist_subscription",
                                "persist_unsubscribe",
                                "cleanup_keys",
                                "complete",
                                null
                              ]
                            },
                            "last_outcome": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "enum": [
                                "processing",
                                "accepted",
                                "failed",
                                null
                              ]
                            },
                            "last_failure": {
                              "type": [
                                "object",
                                "null"
                              ],
                              "properties": {
                                "at": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "code": {
                                  "type": "integer",
                                  "enum": [
                                    -32600,
                                    -32601,
                                    -32602,
                                    -32603,
                                    -32015
                                  ]
                                },
                                "reason": {
                                  "type": "string",
                                  "enum": [
                                    "events_disabled",
                                    "invalid_request",
                                    "invalid_event",
                                    "invalid_arguments",
                                    "invalid_delivery",
                                    "invalid_callback_url",
                                    "invalid_signing_secret",
                                    "replay_unavailable",
                                    "invalid_lifetime",
                                    "subscription_capacity",
                                    "non_public_callback",
                                    "response_too_large",
                                    "callback_failed",
                                    "challenge_failed",
                                    "keychain_unavailable",
                                    "inbox_watch_unavailable",
                                    "inbox_route_changed",
                                    "owner_or_route_unavailable",
                                    "storage_failed",
                                    "event_operation_failed"
                                  ]
                                },
                                "stage": {
                                  "type": "string",
                                  "enum": [
                                    "received",
                                    "authorize",
                                    "validate",
                                    "resolve_routes",
                                    "verify_callback",
                                    "start_watchers",
                                    "reserve_key_reference",
                                    "store_signing_key",
                                    "persist_subscription",
                                    "persist_unsubscribe",
                                    "cleanup_keys",
                                    "complete"
                                  ]
                                }
                              },
                              "required": [
                                "at",
                                "code",
                                "reason",
                                "stage"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "received_count",
                            "accepted_count",
                            "failed_count",
                            "last_received_at",
                            "last_stage",
                            "last_outcome",
                            "last_failure"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "started_at",
                      "methods"
                    ],
                    "additionalProperties": false
                  },
                  "audit_write_failures": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "audit_last_error": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "audit_write_failed",
                      null
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "contract_version",
              "runtime_revision",
              "tool_schema_revision",
              "supported_agent_types",
              "server_time",
              "phase",
              "daemon_status",
              "writes_enabled",
              "enabled_tools",
              "allowed_workspace_aliases",
              "capabilities",
              "limits"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "phase": {
                      "const": "connectivity_only"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "writes_enabled": {
                      "const": false
                    },
                    "enabled_tools": {
                      "const": [
                        "bridge_status"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "writes_enabled": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "enabled_tools": {
                      "not": {
                        "contains": {
                          "enum": [
                            "bridge_session_create",
                            "bridge_message_send"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "writes_enabled": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "phase": {
                      "const": "enabled"
                    },
                    "enabled_tools": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "bridge_session_create"
                          }
                        },
                        {
                          "contains": {
                            "const": "bridge_message_send"
                          }
                        }
                      ]
                    },
                    "capabilities": {
                      "properties": {
                        "durable_idempotency": {
                          "const": true
                        },
                        "dedicated_claude_sessions": {
                          "const": true
                        },
                        "asynchronous_operations": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "PHASE_DISABLED",
                  "NOT_AUTHORIZED",
                  "NOT_FOUND",
                  "WORKSPACE_NOT_ALLOWED",
                  "IDEMPOTENCY_CONFLICT",
                  "IDEMPOTENCY_EXPIRED",
                  "SESSION_BUSY",
                  "CAPACITY_EXCEEDED",
                  "BACKEND_UNAVAILABLE",
                  "BACKEND_PROTOCOL_ERROR",
                  "DELIVERY_UNKNOWN",
                  "OPERATION_EXPIRED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "retryable": {
                "type": "boolean"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^op_[A-Za-z0-9_-]{16,128}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "not": {
              "required": [
                "data"
              ]
            }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
